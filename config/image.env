# ik-os build pinning. Sourced by every build script and by CI.
# SDD §3 (base), §9 (kernel), §47 (package pinning).

# --- Base distribution (SDD §3) -------------------------------------------
# The CODENAME is tracked, never a suite alias. forky is testing today and
# becomes stable on release; naming the codename makes that transition a no-op.
DEBIAN_SUITE=forky
DEBIAN_BASE_IMAGE=docker.io/library/debian:forky-slim

# The build FAILS if the base is not this release (SDD §47). Bump only together
# with an approved release-transition ticket and a full hardware revalidation.
EXPECTED_DEBIAN_CODENAME=forky

# --- Kernel (SDD §9) -------------------------------------------------------
# Until Debian 14 releases the kernel comes from the release itself;
# forky-backports takes over afterwards when a newer kernel is needed.
KERNEL_SUITE=forky
KERNEL_CHANNEL=release
KERNEL_PACKAGE=linux-image-amd64
# Explicit validated version. "whatever the suite currently offers" is not
# acceptable — and matters more while forky is testing, because the archive
# kernel moves often. The build fails if this exact version is unavailable.
KERNEL_VERSION=7.1.8-2

# --- Components not packaged by Debian ------------------------------------
# On Debian 14 only bootc still has to be built from source: forky provides
# ostree 2026.2 and composefs 1.0.8 as maintained packages, both new enough for
# bootc. See docs/adr/0001-bootc-from-source.md.
BOOTC_VERSION=v1.16.9

# --- Install backend (SDD §4, §5) -----------------------------------------
# bootc has two backends and they do NOT support the same bootloaders:
#
#   ostree     grub via bootupd only. systemd-boot is a hard error:
#              "bootupd is required for ostree-based installs".
#   composefs  grub, grub-cc and systemd-boot.
#
# SDD §5 mandates systemd-boot and SDD §4 names composefs, so the composefs
# backend is the only combination that satisfies the specification.
# bootupd is not an escape hatch: it supports GRUB and shim only.
# See docs/adr/0005-composefs-backend.md.
BOOTC_BACKEND=composefs
BOOTC_BOOTLOADER=systemd

# composefs seals images with fs-verity. Leave this false: a target filesystem
# that cannot do fs-verity should fail loudly rather than silently drop an
# integrity guarantee (Rule 18). Set true only to diagnose a verity problem.
BOOTC_ALLOW_MISSING_VERITY=false

# --- Vendor applications --------------------------------------------------
# Claude Desktop. SDD §54 routes GUI applications to Flatpak, but Claude Desktop
# is not on Flathub and not in Debian. Anthropic does publish a first-party
# signed .deb from their own APT repository, so ik-os installs the vendor's own
# package. Recorded in docs/adr/0007-claude-desktop.md.
#
# Set CLAUDE_DESKTOP=false to omit it and its repository entirely.
CLAUDE_DESKTOP=true
# The build verifies the shipped signing key against this fingerprint and fails
# on a mismatch, so a swapped or corrupted key cannot slip into the image.
# Source: https://code.claude.com/docs/en/desktop-linux
CLAUDE_DESKTOP_KEY_FPR=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE

# LsAgent (Lansweeper inventory agent). SDD §54 sends nothing else to the host,
# but there is no Debian package and no vendor APT repository — only a BitRock
# self-extractor — and agentless Linux scanning would mean running an sshd on
# every laptop, which SDD §50 rules out. See docs/adr/0017-lansweeper-agent-in-var.md.
#
# The pin is deliberately NOT the vendor's "latest" pointer: IT states 10.4.2.1 is
# the current Linux release, the version lines are per-platform, and the CDN
# carries builds ahead of the download page. What matters is what the on-prem
# scanning server accepts. Do not bump this by following the redirect —
# re-run scripts/maintenance/fetch-lsagent.sh and confirm with IT.
LSAGENT_VERSION=10.4.2.1
LSAGENT_URL="https://cdn.lansweeper.com/build/lsagent/LsAgent-linux-x64_10.4.2.1.run"
# Verified 2026-09-01: 34721743 bytes, ELF x86-64 InstallBuilder self-extractor.
# First boot refuses to install a payload that does not match this.
LSAGENT_SHA256=fb36233475e398f49dd5c8abae0ae545d647850fa78b210c38c17a3bf63a7e17
LSAGENT_SIZE=34721743

# --- Desktop branding (SDD §14) -------------------------------------------
# The wallpaper shipped as the company default. Every image in
# branding/wallpaper/ is installed and offered in GNOME Settings; this one is
# what a new account starts with. The build fails if the file is missing, so a
# rename cannot silently fall back to something else.
IK_OS_DEFAULT_WALLPAPER=ik-hubble.jpg

# --- Image identity (SDD §57) ---------------------------------------------
IK_OS_NAME=ik-os
IK_OS_PRETTY_NAME="ik-os"
IK_OS_ID=ik-os
IK_OS_ID_LIKE=debian
IK_OS_HOME_URL=https://github.com/interligent-kommunzieren-gmbh/ik-os-next
IK_OS_VENDOR="Interligent Kommunizieren GmbH"
