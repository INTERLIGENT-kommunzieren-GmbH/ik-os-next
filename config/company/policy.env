# Company policy knobs (SDD §38, §39). Read by first boot and by the ik-os CLI.
# Deliberately configurable: the identity provider and management backend must
# not be hardcoded into the OS.

# --- enrolment (SDD §38) ---------------------------------------------------
ENROLLMENT_ENABLED="false"
ENROLLMENT_URL=""
ENROLLMENT_MODE="interactive"

# --- VPN (SDD §27) ---------------------------------------------------------
# image       — the identity ships in the image, installed from
#               config/company/vpn/certs at build time. The VPN works on a
#               freshly installed machine with no further steps, which is the
#               point (ADR 0018).
# manual      — an administrator places the bundle in /var/lib/ik-os/vpn
# enrollment  — fetch it from ENROLLMENT_URL (no such service exists yet)
# disabled    — no company VPN on this machine
#
# A bundle in /var/lib/ik-os/vpn always takes precedence over the image's, in
# every mode, so a machine given its own identity keeps it across updates.
VPN_PROVISION_MODE="image"
VPN_REMOTE="vpn.interligent.com"
VPN_PORT="11194"
# Quoted: NetworkManager wants the trailing ";" and this file is sourced by shell.
VPN_DNS="192.168.77.10;"
VPN_DNS_SEARCH="intern.interligent.com;rz01.interligent.com;rz02.interligent.com;projects.interligent.com;"

# --- Docker (SDD §51) ------------------------------------------------------
# first-user  — the account created at first boot joins the docker group
# none        — membership is granted manually by IT
DOCKER_GROUP_POLICY="first-user"

# --- updates (SDD §40) -----------------------------------------------------
IK_OS_REGISTRY="ghcr.io/interligent-kommunzieren-gmbh/ik-os-next"
# The channel this machine follows for updates. Deliberately a different name
# from IK_OS_CHANNEL in release.env, which records the channel the running image
# was built for — the two are not always the same, and the CLI reports both.
IK_OS_UPDATE_CHANNEL="stable"
AUTO_UPDATE="false"

# --- asset inventory (SDD §38, ADR 0017) ----------------------------------
# LsAgent reports this machine to the on-prem Lansweeper scanning server.
#
# Two things a later change must not get wrong:
#   * The server is reachable ONLY over a VPN (ik-office, or a user-configured
#     tunnel to the datacenter). Do not "fix" the first-boot step by making it
#     wait for reachability — it installs and configures, and reporting is
#     triggered separately when a tunnel comes up.
#   * Lansweeper's Cloud Relay (--agentkey) is excluded by decision, not by
#     oversight. Its key is a company auth token and would need per-device
#     provisioning (Rule 13). Adding it is an ADR, not a knob.
LANSWEEPER_ENABLED="true"
LANSWEEPER_SERVER="lansweeper.intern.interligent.com"
LANSWEEPER_PORT="9524"
