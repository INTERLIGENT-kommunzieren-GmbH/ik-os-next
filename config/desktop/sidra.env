# The pinned Sidra release (ADR 0019).
#
# build/scripts/53-sidra.sh downloads exactly this version and refuses to
# continue unless the artefact matches SIDRA_DEB_SHA256. Both values are
# rewritten together by:
#
#     scripts/maintenance/update-sidra.sh
#
# Do not edit the checksum by hand. A version bumped without its checksum fails
# the build, which is the intended behaviour — the alternative is installing an
# unverified 98 MiB binary from the internet into the immutable host.
#
# Upstream publishes no signature and no checksum file, so this digest records
# what was actually served when a human ran the update script. It is
# tamper-evidence between builds, not proof of provenance.
#
# Upstream: https://github.com/wimpysworld/sidra/releases
SIDRA_VERSION=1.1.1
SIDRA_DEB_SHA256=2b948f7532efd10b9ce4f5da1607ec655bc5a3b47f31a1d4db7db55296eefa75
