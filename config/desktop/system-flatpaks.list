io.dbeaver.DBeaverCommunity
io.podman_desktop.PodmanDesktop
sh.loft.devpod
me.iepure.devtoolbox

# Postman still targets org.freedesktop.Platform 24.08 — see the runtime note.
com.getpostman.Postman

# --- Containers and compatibility ------------------------------------------
com.usebottles.bottles
io.github.prateekmedia.appimagepool

# --- Flatpak and desktop management ----------------------------------------
# On a Flatpak-first image these are not optional extras: Flatseal is the only
# way to adjust an app's sandbox, and Ignition the only way to manage autostart
# without writing into the immutable /usr.
com.github.tchx84.Flatseal
io.github.flattool.Ignition
page.tesk.Refine

# --- Graphics --------------------------------------------------------------
org.gimp.GIMP
org.inkscape.Inkscape
com.github.PintaProject.Pinta
be.alexandervanhee.gradia

# --- Documents and office --------------------------------------------------
org.libreoffice.LibreOffice

# The image ships no document viewer at all, so without Papers a PDF has
# nothing to open it with.
org.gnome.Papers
com.github.jeromerobert.pdfarranger
com.jgraph.drawio.desktop
md.obsidian.Obsidian

