# it here rather than in the immutable host.
io.missioncenter.MissionCenter
io.github.thetumultuousunicornofdarkness.cpu-x
org.gnome.baobab
org.gnome.Logs
xyz.ketok.Speedtest
io.github.pwr_solaar.solaar
com.sidevesh.Luminance

# --- Desk accessories ------------------------------------------------------
# Calculator is in the same category as Papers and File Roller: absent from the
# image, and referenced by Debian's own default dash favourites.
org.gnome.Calculator
org.gnome.Characters
it.mijorus.smile
org.gnome.clocks
org.gnome.Weather
org.gnome.Maps

# Previews the Nerd Fonts that config/desktop/Brewfile installs as casks.
org.gnome.font-viewer

# --- Runtime footprint -----------------------------------------------------
# These apps need six different runtimes, and three of them exist for a handful
# of stragglers:
#
#   org.gnome.Platform 50          37 apps      1.1 GB
#   org.freedesktop.Platform 25.08 12 apps      660 MB
#   org.gnome.Platform 49           5 apps      1.1 GB
#   org.kde.Platform 5.15-25.08     2 apps      974 MB   KeePassXC, Thincast
#   org.gnome.Platform 47           1 app       1.0 GB   DevPod
#   org.freedesktop.Platform 24.08  1 app       691 MB   Postman
#
# That is ~5.5 GB of runtime on top of ~6.7 GiB of applications, so first boot
# pulls roughly 12 GB from Flathub. check-flatpaks.sh prints these numbers on
# every run, which is the copy to trust if this block drifts.
#
# The last two are end-of-life branches: they receive no further security
# updates, and each costs ~1 GB for one application. Worth revisiting when
# DevPod and Postman move forward, or if either app can be dropped.
