# Pairs with the CUPS/SANE stack in packages/printing.
org.gnome.SimpleScan
io.gitlab.adhami3310.Impression

# --- Media -----------------------------------------------------------------
org.gnome.Showtime
io.bassi.Amberol

# No image viewer in the image either — without Loupe, double-clicking a JPEG
# falls through to GIMP.
org.gnome.Loupe
org.gnome.Snapshot

# Miracast/Chromecast screen sharing for meeting rooms.
org.gnome.NetworkDisplays

# --- System and hardware ---------------------------------------------------
# Mission Center replaces gnome-system-monitor, which was dropped from
