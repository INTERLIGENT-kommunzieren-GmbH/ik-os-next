# The pinned draw.io Desktop release (ADR 0016).
#
# build/scripts/52-drawio.sh downloads exactly this version and refuses to
# continue unless the artefact matches DRAWIO_DEB_SHA256. Both values are
# rewritten together by:
#
#     scripts/maintenance/update-drawio.sh
#
# Do not edit the checksum by hand. A version bumped without its checksum fails
# the build, which is the intended behaviour — the alternative is installing an
# unverified 127 MiB binary from the internet into the immutable host.
#
# Upstream: https://github.com/jgraph/drawio-desktop/releases
DRAWIO_VERSION=31.3.2
DRAWIO_DEB_SHA256=725453f32ef7f2f63f8b50b374857a5c312e2aaabcf221cb0600332741ae1094
