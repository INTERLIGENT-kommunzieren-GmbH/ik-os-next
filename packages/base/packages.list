# ik-os base OS packages (SDD §56).
# Rule 11: every package needs a documented reason. Keep this file justified.

## --- init, core userspace -------------------------------------------------
systemd                 # init (SDD §59: no custom init system)
systemd-sysv
systemd-resolved        # DNS; required for the VPN split-DNS profile (config/company)
# Rule 11: 65-printing.sh puts "resolve" and "myhostname" in the nsswitch hosts
# line. glibc silently ignores an NSS module whose library is absent, so without
# these two the line is a lie: systemd-resolved is bypassed, and the machine
# cannot resolve its own hostname — every sudo prints
# "unable to resolve host ik-<id>: System error" and pauses first.
libnss-resolve          # the "resolve" NSS module (systemd-resolved)
libnss-myhostname       # the "myhostname" NSS module; resolves the local hostname
systemd-timesyncd
udev
dbus
dbus-user-session
polkitd                 # privilege escalation for GNOME Settings (printers, SDD §23)
sudo
libpam-systemd
util-linux
uuid-runtime            # uuidgen, used to generate the NetworkManager VPN profile UUID
pciutils                # lspci, used by `ik-os hardware` (SDD §48)
usbutils                # lsusb, used by `ik-os hardware` (SDD §48)
coreutils
procps
bash
netbase
locales
tzdata
ca-certificates         # trust store; CA-IK is added on top (config/company)
less
gnupg
curl
wget
zstd
xz-utils
jq                      # used by ik-os diagnostics / migration tooling

## --- immutable OS plumbing (SDD §4) ---------------------------------------
ostree                  # 2026.2 in Debian 14 — new enough for bootc, so no
ostree-boot             # upstream build is needed any more (ADR 0001).
composefs               # mkcomposefs et al; the composefs backend needs them.
dracut                  # initramfs with the ostree module
dracut-network
kmod
skopeo                  # image inspection for `ik-os status` / migration
# NOTE: bootc alone is not packaged by Debian and is built from a pinned
# upstream tag in the Containerfile. See docs/adr/0001-bootc-from-source.md.

## --- boot (SDD §5) --------------------------------------------------------
systemd-boot
systemd-boot-efi
efibootmgr
shim-signed             # Secure Boot chain entry; see docs/adr/0002-secure-boot.md
mokutil
sbsigntool              # sign systemd-boot with the company MOK at build time

## --- filesystems ----------------------------------------------------------
e2fsprogs
btrfs-progs             # default root filesystem for ik-os disk images
dosfstools              # ESP
fdisk                   # sfdisk. Debian splits it out of util-linux, and
                        # `bootc install to-disk` shells out to it to partition
                        # the target — without it installation fails at the
                        # very first step. Filesystem growth needs no extra
                        # package: systemd-growfs handles it.
cryptsetup              # the installer's LUKS2 container (ADR 0022), and the
                        # cryptsetup binary the dracut crypt module needs
systemd-cryptsetup      # /usr/lib/systemd/systemd-cryptsetup, which Debian
                        # splits out of systemd. The dracut systemd-cryptsetup
                        # module is what honours rd.luks.uuid= in a
                        # systemd initramfs, and without this package dracut
                        # refuses to build at all: "Module
                        # 'systemd-cryptsetup' cannot be installed."

## --- networking -----------------------------------------------------------
network-manager
network-manager-tui             # nmtui. The graphical path is not always
                                # there: GNOME's Wi-Fi dialog depends on a
                                # secret agent, and when that agent cannot
                                # reach a Secret Service the dialog closes
                                # without ever asking for a password --
                                # observed on a deployed machine. nmtui needs
                                # no agent, no session and no keyring, handles
                                # both WPA2 personal and 802.1X enterprise, and
                                # is 900 kB. It is also what the installer uses,
                                # so the same tool works before and after
                                # installation.
network-manager-openvpn         # company VPN (config/company, SDD §39) --
                                # the NM service plugin, which is only the
                                # daemon half.
network-manager-openvpn-gnome   # the other half, and not pulled in by the
                                # above: the editor plugins GNOME loads to
                                # render the ik-office profile
                                # (libnm-gtk4-vpn-plugin-openvpn-editor.so for
                                # gnome-control-center, the GTK3 one for
                                # nm-connection-editor), plus
                                # nm-openvpn-auth-dialog, which prompts for
                                # the credentials the profile deliberately
                                # does not store (password-flags=4). Without
                                # it Settings says "unable to load VPN
                                # connection editor" and the connection can
                                # never ask for a password.
wireless-regdb
wpasupplicant           # NetworkManager cannot use a wireless card at all
                        # without it: the driver loads, the device appears, and
                        # no network is ever listed, which reads as a firmware
                        # or driver fault and is not one. It is only a
                        # Recommends of network-manager, and this image sets
                        # APT::Install-Recommends "false"
                        # (config/apt/99-ik-os-immutable.conf), so it has to be
                        # named here. Found on a deployed Dell XPS 13 with an
                        # Intel AX201: firmware-iwlwifi and wireless-regdb were
                        # both present and Wi-Fi still showed nothing.
iproute2
iputils-ping
openssh-client
openssh-server          # NOT enabled: the preset disables ssh.service and
                        # ssh.socket, and firewalld does not open the port, so
                        # a stock machine still listens on nothing (SDD §50).
                        # It is here so that "Remote Login" in GNOME Settings
                        # can be switched on when someone needs it, instead of
                        # failing with no explanation. See ADR 0023.
# ik-os-teams-backgrounds.service is written in Python (ADR 0020). python3 is
# already pulled in as a dependency -- firewalld is a Python program -- but a
# service whose ExecStart depends on somebody else's Depends is one package
# removal away from a unit that fails at boot with "No such file or directory".
python3

## --- security (SDD §50) ---------------------------------------------------
apparmor
apparmor-profiles
firewalld               # supported firewall configuration, managed via config/security
