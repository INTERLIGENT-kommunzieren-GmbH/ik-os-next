# ik-os company desktop defaults (SDD §14).
# These are *defaults*: users may change them. Settings that company policy
# pins are listed in desktop/gnome/dconf/ik-os.d/locks/.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita'
icon-theme='Adwaita'
font-name='Cantarell 11'
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true

# The wallpaper is NOT set here. 55-branding.sh writes 05-background only when
# branding/wallpaper/ actually contains an image; otherwise the GNOME default
# is left alone. Pointing picture-uri at the company logo — which this file
# used to do — puts a 1.5 KB logo across every desktop.

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
dynamic-workspaces=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer']

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'
