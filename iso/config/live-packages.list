# Packages for the ik-os live installer environment. This is NOT the ik-os
# image: it is the throwaway system that runs the installer.
linux-image-amd64
live-boot
systemd-sysv
init
udev
dbus
network-manager
iproute2
iputils-ping
ca-certificates
bootc-placeholder
# bootc is extracted from the payload image, but its shared libraries are not:
# they come from here, at the same suite as the image so the versions match.
ostree
composefs
# BOOTC_BOOTLOADER=systemd -- bootc needs bootctl and the systemd-boot EFI
# binaries to make the installed disk bootable.
systemd-boot
podman
skopeo
whiptail
parted
gdisk
btrfs-progs
e2fsprogs
dosfstools
util-linux
kmod
less
nano
zstd
