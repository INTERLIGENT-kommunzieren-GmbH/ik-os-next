[Unit]
Description=ik-os installer
After=multi-user.target systemd-udev-settle.service
ConditionKernelCommandLine=ik-os.install

[Service]
Type=idle
ExecStart=/usr/bin/ik-os-installer
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
