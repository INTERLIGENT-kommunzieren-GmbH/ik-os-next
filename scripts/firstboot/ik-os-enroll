#!/bin/bash
# SDD §38 — device enrolment. The identity provider and management backend are
# configurable and intentionally not hardcoded.
set -euo pipefail
# shellcheck disable=SC1091
. /usr/lib/ik-os/policy.env
# shellcheck disable=SC1091
. /usr/share/ik-os/release.env

log() { printf '[ik-os-enroll] %s\n' "$*"; }

[[ "${ENROLLMENT_ENABLED:-false}" == "true" ]] || { log "enrolment disabled by policy"; exit 0; }
[[ -n "${ENROLLMENT_URL:-}" ]] || { log "ENROLLMENT_ENABLED=true but ENROLLMENT_URL is empty"; exit 1; }

payload=$(cat <<EOF
{
  "device_id":     "$(cat /etc/machine-id)",
  "hostname":      "$(hostnamectl --static 2>/dev/null || hostname)",
  "hardware_model":"$(cat /sys/class/dmi/id/product_name 2>/dev/null)",
  "hardware_profile": "$(ik-os hardware | awk '/Profile/{print $2}')",
  "os_version":    "${IK_OS_VERSION:-dev}",
  "image_digest":  "$(bootc status --json 2>/dev/null | jq -r '.status.booted.image.imageDigest // "unknown"')",
  "kernel":        "$(uname -r)",
  "user":          "$(awk -F: '$3>=1000 && $3<65000 {print $1; exit}' /etc/passwd)"
}
EOF
)
log "enrolling with ${ENROLLMENT_URL}"
curl -fsSL -X POST -H 'Content-Type: application/json' \
     --data "$payload" "${ENROLLMENT_URL%/}/enroll" >/dev/null
log "enrolled"
